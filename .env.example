# Variables de entorno de EcoConecta. Solo los nombres: los valores reales nunca van al repo.
ENTORNO=            # local | produccion (en producción la cookie de sesión va solo por HTTPS)
CLAVE_SESION=       # cadena larga y aleatoria; firma la cookie de sesión
CLAVE_DEMO=         # clave de los usuarios de demostración: huerteros, recicladores y admin
CODIGO_REGISTRO=    # código que la fundación da a quien crea su cuenta de coordinación (ADR-0009)
SEMBRAR_DEMO=       # 1 carga zonas, encargados, usuarios y contenidos ficticios
TRANSPORTE=         # simulado | twilio (adaptador de Jorge)
CONVERSADOR=        # menu | llm (conversador de Leonardo)
DATABASE_URL=       # postgresql+psycopg://usuario:clave@servidor:5432/ecoconecta (en local es opcional)
# Twilio (Jorge):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# TWILIO_WEBHOOK_URL=     # URL HTTPS exacta que termina en /api/whatsapp/twilio
# TWILIO_RESPUESTA_TWIML= # 1 para devolver en el webhook las respuestas inmediatas del Sandbox clásico
# TWILIO_COORDINACION_EN_WEBHOOK= # 1 para entregar mensajes de coordinación en el próximo mensaje del vecino
# WHATSAPP_PILOT_NUMBERS= # teléfonos E.164 separados por comas
# WHATSAPP_CONTACT_ALIASES= # pares BSUID=teléfono E.164 verificados, separados por comas
# WHATSAPP_REPLIES_FILE=  # ruta al JSON de respuestas editables
# LLM de texto (opcional con CONVERSADOR=llm):
# OPENAI_BASE_URL=       # endpoint Azure OpenAI de Foundry, por ejemplo https://<recurso>.openai.azure.com/openai/v1
# OPENAI_API_KEY=        # una clave del recurso de Azure OpenAI
# CONVERSADOR_MODELO=    # nombre exacto del despliegue de texto en Foundry
# CONVERSADOR_RAZONAMIENTO= # minimal para GPT-5 y GPT-5 mini; deja vacío para GPT-4.1 mini
# Revisión de fotos (Leonardo): usa el mismo OPENAI_BASE_URL y OPENAI_API_KEY.
# CLASIFICACION_MODELO=  # nombre del despliegue con visión, por ejemplo gpt-5-mini
# CLASIFICACION_ACTIVA=  # true revisa las fotos que llegan por WhatsApp
