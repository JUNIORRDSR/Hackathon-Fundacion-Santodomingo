# Variables de entorno de EcoConecta. Solo los nombres: los valores reales nunca van al repo.
ENTORNO=            # local | produccion (en producción la cookie de sesión va solo por HTTPS)
CLAVE_SESION=       # cadena larga y aleatoria; firma la cookie de sesión
CLAVE_DEMO=         # clave de los usuarios de demostración: huerteros, recicladores y admin
CODIGO_REGISTRO=    # código que la fundación da a quien crea su cuenta de coordinación (ADR-0009)
SEMBRAR_DEMO=       # 1 carga zonas, encargados, usuarios y contenidos ficticios
TRANSPORTE=         # simulado | twilio (adaptador de Jorge)
CONVERSADOR=        # menu | llm (conversador de Leonardo)
DATABASE_URL=       # postgresql+psycopg://usuario:clave@servidor:5432/ecoconecta (en local es opcional)
# Twilio (Jorge):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# Azure OpenAI por su API v1, compartido por la revisión de fotos (Leonardo) y el conversador LLM (Jorge).
# Sin OPENAI_BASE_URL se usa la API de OpenAI.
OPENAI_BASE_URL=        # https://<recurso>.openai.azure.com/openai/v1/
OPENAI_API_KEY=         # clave del recurso de Azure OpenAI (o de OpenAI)
CLASIFICACION_MODELO=   # nombre del despliegue con visión, por ejemplo gpt-5-mini
CLASIFICACION_ACTIVA=   # true revisa las fotos que llegan por WhatsApp (ADR-0011)
